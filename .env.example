# --- Overlay Wealth Environment Variables ---

# GEMINI_API_KEY: Required for Gemini AI API calls (Module Builder feature)
GEMINI_API_KEY=

# APP_URL: The URL where the app is hosted (used for the sitemap and self-referential links)
# In production, set this to your real domain, e.g. https://overlay365.org
APP_URL=http://localhost:3000

# PORT: HTTP port the server binds to (default 3000 if unset)
PORT=3000

# ALPHA_VANTAGE_API_KEY: Stock market data for the Trading Simulator
# Get a free key at https://www.alphavantage.co/support/#api-key
# If omitted, the simulator uses a high-fidelity random walk fallback
ALPHA_VANTAGE_API_KEY=

# NODE_ENV: Set to "production" for production builds. If unset, the server
# automatically serves the built app when dist/index.html exists.
NODE_ENV=development

# ALLOWED_ORIGINS: Comma separated list of allowed CORS origins
# WARNING: "*" is for local development only. In production, always set this to
# your real domain(s), e.g. https://overlay365.org
ALLOWED_ORIGINS=*

# VITE_POSTHOG_KEY: PostHog project API key for analytics and feature flags
# Get a free key at https://posthog.com/ (no credit card required)
# If omitted, analytics and A/B testing are no-ops
VITE_POSTHOG_KEY=
STRIPE_DONATION_LINK=https://buy.stripe.com/dRm6oJa7yevp2jF3em3oA06

# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET: Used to sign auth tokens for real
# accounts (bcrypt + JWT auth). ALWAYS set long random values in production;
# dev-only fallbacks are used when unset.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# DATABASE_URL: PostgreSQL connection string. When set, the server dual-writes
# progress/users/donations to Postgres and hydrates from it on boot. When unset
# (local dev/tests), the file-backed store is used. Always set in production.
#
# Supabase (recommended): Project Settings -> Database -> Connection string ->
# "Transaction pooler" (port 6543). Paste the full postgresql:// URL here.
# The app's migrations + sync work against it unchanged — it's just Postgres.
DATABASE_URL=
# DATABASE_POOL_SIZE: Max Postgres pool connections (default 10)
DATABASE_POOL_SIZE=

# Supabase keys. These must point at the SAME shared ecosystem project used for
# identity (hjjgsbejhkwiyghncobe); they are the service-role credentials for
# token verification + profile sync. SERVICE_ROLE is a secret and must only ever
# live server-side. Prefer the ECOSYSTEM_-prefixed names so there is one source
# of truth; SUPABASE_* remain as legacy fallbacks.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
ECOSYSTEM_SUPABASE_SERVICE_ROLE_KEY=

# AUTH_MODE: Which auth stack the server uses. "legacy" (default) = bcrypt+JWT
# accounts stored in db.users; "supabase" = shared Overlay365 identity backed by
# the ecosystem Supabase project (requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# above, pointed at the shared project). Clients keep working unchanged in both
# modes. Rollback: keep "legacy" until 2 weeks of green telemetry, then delete
# legacy paths.
AUTH_MODE=legacy

# --- Ecosystem shared auth (Overlay365 identity, auth-only) ---
# One Supabase project is the ecosystem Google/identity IdP; Wealth keeps its
# own database. Server verifies tokens against <ECOSYSTEM_SUPABASE_URL>/auth/v1/user
# (anon key, 8s timeout); GET /api/auth/ecosystem/me is 503 until both are set.
# When set, valid ecosystem tokens also identify callers in legacy AUTH_MODE.
# The email/password + Google OAuth routes (supabase mode) also run against this
# project via the ECOSYSTEM_* browser env below.
ECOSYSTEM_SUPABASE_URL=https://hjjgsbejhkwiyghncobe.supabase.co
ECOSYSTEM_SUPABASE_ANON_KEY=

# Server-side Google OAuth (PKCE) resolves the shared project's anon key here;
# the client ecosystem login resolves the VITE_* pair below. Set all four.
NEXT_PUBLIC_ECOSYSTEM_SUPABASE_URL=https://hjjgsbejhkwiyghncobe.supabase.co
NEXT_PUBLIC_ECOSYSTEM_SUPABASE_ANON_KEY=

# Client-side ecosystem Google login (browser-safe anon key; renders nothing
# in <EcosystemLogin /> until both are set). Existing email + server Google
# OAuth flows are untouched.
VITE_ECOSYSTEM_SUPABASE_URL=https://hjjgsbejhkwiyghncobe.supabase.co
VITE_ECOSYSTEM_SUPABASE_ANON_KEY=

# SENTRY_DSN: Error tracking (client reads VITE_SENTRY_DSN; server reads
# SENTRY_DSN). Both are no-ops when unset. Get one at https://sentry.io
VITE_SENTRY_DSN=
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE: 0-1 sampling for performance traces (default 0.1)
SENTRY_TRACES_SAMPLE_RATE=

# EMAIL_API_KEY / EMAIL_FROM: Transactional email (Resend). Welcome emails on
# signup and waitlist confirmations are no-ops when unset. Get a key at
# https://resend.com and verify your sending domain.
EMAIL_API_KEY=
EMAIL_FROM=noreply@overlaywealth.org

# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_PRICE_*: Subscriptions
# (Premium $10/mo, Institutional $99/mo). Billing endpoints no-op when unset.
# Create prices in Stripe and paste the IDs here. Set the webhook to point at
# https://your-host/api/billing/webhook with event types:
# checkout.session.completed, customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_INSTITUTIONAL=
