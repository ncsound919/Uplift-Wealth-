# --- Overlay Wealth Environment Variables ---

# GEMINI_API_KEY: Required for Gemini AI API calls (Module Builder feature)
GEMINI_API_KEY=

# APP_URL: The URL where the app is hosted (used for the sitemap and self-referential links)
# In production, set this to your real domain, e.g. https://overlay365.org
APP_URL=http://localhost:3000

# PORT: HTTP port the server binds to (default 3000 if unset)
PORT=3000

# ALPHA_VANTAGE_API_KEY: Stock market data for the Trading Simulator
# Get a free key at https://www.alphavantage.co/support/#api-key
# If omitted, the simulator uses a high-fidelity random walk fallback
ALPHA_VANTAGE_API_KEY=

# NODE_ENV: Set to "production" for production builds. If unset, the server
# automatically serves the built app when dist/index.html exists.
NODE_ENV=development

# ALLOWED_ORIGINS: Comma separated list of allowed CORS origins
# WARNING: "*" is for local development only. In production, always set this to
# your real domain(s), e.g. https://overlay365.org
ALLOWED_ORIGINS=*

# VITE_POSTHOG_KEY: PostHog project API key for analytics and feature flags
# Get a free key at https://posthog.com/ (no credit card required)
# If omitted, analytics and A/B testing are no-ops
VITE_POSTHOG_KEY=
STRIPE_DONATION_LINK=https://buy.stripe.com/dRm6oJa7yevp2jF3em3oA06

# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET: Used to sign auth tokens for real
# accounts (bcrypt + JWT auth). ALWAYS set long random values in production;
# dev-only fallbacks are used when unset.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# DATABASE_URL: PostgreSQL connection string. When set, the server dual-writes
# progress/users/donations to Postgres and hydrates from it on boot. When unset
# (local dev/tests), the file-backed store is used. Always set in production.
DATABASE_URL=
# DATABASE_POOL_SIZE: Max Postgres pool connections (default 10)
DATABASE_POOL_SIZE=

# SENTRY_DSN: Error tracking (client reads VITE_SENTRY_DSN; server reads
# SENTRY_DSN). Both are no-ops when unset. Get one at https://sentry.io
VITE_SENTRY_DSN=
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE: 0-1 sampling for performance traces (default 0.1)
SENTRY_TRACES_SAMPLE_RATE=

# EMAIL_API_KEY / EMAIL_FROM: Transactional email (Resend). Welcome emails on
# signup and waitlist confirmations are no-ops when unset. Get a key at
# https://resend.com and verify your sending domain.
EMAIL_API_KEY=
EMAIL_FROM=noreply@overlaywealth.org

# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_PRICE_*: Subscriptions
# (Premium $10/mo, Institutional $99/mo). Billing endpoints no-op when unset.
# Create prices in Stripe and paste the IDs here. Set the webhook to point at
# https://your-host/api/billing/webhook with event types:
# checkout.session.completed, customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_INSTITUTIONAL=
